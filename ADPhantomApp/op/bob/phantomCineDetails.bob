    <name>EDM Group 1</name>
    <x>270</x>
    <y>330</y>
    <width>95</width>
    <height>40</height>
    <style>3</style>
    <transparent>true</transparent>
    <rules>
      <rule name="EDM visibility" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0&gt;=0.0 &amp;&amp; pv0&lt;1.0">
          <value>false</value>
        </exp>
        <exp bool_exp="true">
          <value>true</value>
        </exp>
        <pv_name>$(P)$(R)DownloadCount_RBV</pv_name>
      </rule>
    </rules>
